# Copy to .env and export, or set these in your process manager.

# Listen
PORT=8787
HOST=0.0.0.0

# Optional: require clients to send Authorization: Bearer <this>
# API_KEY=sk-local

DEFAULT_MODEL=deepseek-chat

# Token sources (merged with ./tokens.txt)
# DEEPSEEK_TOKENS=token1,token2
# DEEPSEEK_TOKENS_FILE=./tokens.txt

# Pre-warm cache (removes ~320ms of per-request prep; refills are staggered)
WARM_POOL=3
WARM_SESSION_USES=4
WARM_SESSION_POOL=1
# WARM_REFILL_DELAY_MS=750
# WARM_REFILL_JITTER_MS=600

# Rate limiting / pacing (conservative, human-like; reduces automation signals)
# RATE_BURST=4
# RATE_REFILL_MS=6000
# RATE_COOLDOWN_MS=45000
# RATE_COOLDOWN_MAX_MS=300000
# RATE_JITTER_MS=500
# RATE_MIN_GAP_MS=1500
# RATE_MAX_WAIT_MS=35000
# WATCHDOG_MS=120000
# WATCHDOG_JITTER_MS=20000
# LOG_REQUESTS=1

# Debug: dump every incoming request body to this directory (unset to disable)
# DEBUG_BODY_DIR=/tmp/dsbody

# Route upstream calls through an HTTP proxy (avoids datacenter-IP revocation)
# DEEPSEEK_PROXY=http://user:pass@proxy-host:8080

# Automatic re-login when DeepSeek revokes the token
# DEEPSEEK_EMAIL=you@example.com
# DEEPSEEK_PASSWORD=
# DEEPSEEK_TOKEN_PERSIST=1

# Automated signup (scripts/signup.js)
# CAPTCHA_PROVIDER=none           # capsolver | 2captcha | browser
# CAPSOLVER_KEY=
# TWOCAPTCHA_KEY=
# CHROME_PATH=
# MAILBOX=mailtm                  # imap | http | mailtm
# MAILBOX_URL=
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_TLS=1
# IMAP_MAILBOX=INBOX
